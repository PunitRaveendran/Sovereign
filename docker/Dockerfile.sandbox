# ==============================================================================
# Sovereign AI Workbench — Air-Gapped Code Execution Sandbox
# ==============================================================================
# ARCHITECTURAL DESIGN NOTE:
# The sandbox is built for strictly isolated code execution (math, physical simulations,
# data transformations). Under `--network none`, ALL networking is physically blocked
# by the Linux kernel. No socket can connect out, and no internal loopback to the KB
# or host services is permitted from inside the container.
#
# All retrieval, RAG, and audit logging happen OUTSIDE the sandbox at the Agent layer.
# All pre-installed packages must exist in this image so no runtime `pip install` is needed.
# ==============================================================================

FROM python:3.12-slim

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install core scientific and engineering calculation libraries
# Used for industrial plant calculations (hydraulics, flow rates, stress tests, vibration math)
RUN pip install --no-cache-dir \
    numpy>=1.26.0 \
    scipy>=1.12.0 \
    pandas>=2.2.0 \
    sympy>=1.12

# Create non-root user for principle of least privilege
RUN useradd -m -u 1000 -s /bin/bash sandboxuser && \
    mkdir -p /code && \
    chown -R sandboxuser:sandboxuser /code

WORKDIR /code
USER sandboxuser

# Default entrypoint for script execution
ENTRYPOINT ["python", "-u"]
