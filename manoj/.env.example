# Sovereign — .env template
# Copy this to .env and adjust for your machine.
# All values have sensible defaults in config.py — only override what you need.

# ── Paths ──────────────────────────────────────────────────────────────────────
# BASE_DIR=.
# DATA_DIR=./data
# CHROMA_DIR=./chroma_db
# OUTPUT_DIR=./outputs
# AUDIT_LOG_PATH=./audit.log

# ── Embedding model ───────────────────────────────────────────────────────────
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DEVICE=cpu   # set to "cuda" on the demo machine with GPU

# ── Chunking ──────────────────────────────────────────────────────────────────
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64

# ── Retrieval ─────────────────────────────────────────────────────────────────
# RETRIEVAL_K=6

# ── Network monitor ───────────────────────────────────────────────────────────
# MONITOR_INTERFACE=eth0    # Linux: "eth0" or "enp0s3"; Windows: "Ethernet"
# MONITOR_POLL_INTERVAL=1.0

# ── API ────────────────────────────────────────────────────────────────────────
# API_HOST=127.0.0.1
# API_PORT=8001
